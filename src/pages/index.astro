---
const title = "Totsukō Hearts";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Totsukō Hearts — locomotivas históricas reinterpretadas como androides de corrida."
    />

    <title>{title}</title>
  </head>

  <body>
    <main>
      <p class="eyebrow">WELCOME TO RAILIA</p>

      <h1>Totsukō Hearts</h1>

      <p class="description">
        Locomotivas que fizeram história ganham uma nova vida como
        androides de corrida.
      </p>
<a href={`${import.meta.env.BASE_URL}hearts/`}>
  Conheça as Hearts →
</a>
   
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #11100e;
    color: #eee8da;
    font-family: Georgia, serif;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 32px;
    text-align: center;
  }

  .eyebrow {
    letter-spacing: 0.25rem;
    font-size: 0.75rem;
    color: #b7a47b;
  }

  h1 {
    margin: 12px 0;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: normal;
  }

  .description {
    max-width: 550px;
    line-height: 1.7;
    color: #c9c2b4;
  }

  a {
    margin-top: 25px;
    padding: 13px 22px;
    border: 1px solid #b7a47b;
    color: #eee8da;
    text-decoration: none;
    letter-spacing: 0.05rem;
  }

  a:hover {
    background: #b7a47b;
    color: #11100e;
  }
</style>
